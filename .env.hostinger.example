APP_NAME="FlowState ERP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_URL=https://flowstate.dorisle.tech
FRONTEND_URL=https://flowstate.dorisle.tech

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u123456789_flowstate
DB_USERNAME=u123456789_flow
DB_PASSWORD=change-me

# Shared Hostinger usually has no Redis.
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync
IDEMPOTENCY_STORE=database
IDEMPOTENCY_TTL=60

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Same origin: UI + API on flowstate.dorisle.tech (/api/v1/...)
L5_SWAGGER_CONST_HOST=https://flowstate.dorisle.tech
L5_SWAGGER_GENERATE_ALWAYS=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@flowstate.dorisle.tech"
MAIL_FROM_NAME="${APP_NAME}"
